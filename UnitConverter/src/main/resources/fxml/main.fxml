<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/8.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unitconverter.ui.MainController">
    <top>
        <MenuBar>
            <Menu text="文件">
                <MenuItem text="保存设置" onAction="#handleSaveSettings"/>
                <SeparatorMenuItem/>
                <MenuItem text="退出" onAction="#handleExit"/>
            </Menu>
            <Menu text="帮助">
                <MenuItem text="关于" onAction="#handleAbout"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab fx:id="converterTab" text="单位换算">
                <content>
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="单位类型:" prefWidth="80"/>
                            <ComboBox fx:id="unitTypeComboBox" prefWidth="150"/>
                        </HBox>

                        <HBox spacing="20" alignment="CENTER">
                            <VBox spacing="5">
                                <Label text="源单位" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="fromUnitComboBox" prefWidth="200"/>
                                <Label text="输入值:"/>
                                <TextField fx:id="inputValueTextField" prefWidth="200" promptText="请输入数值"/>
                            </VBox>

                            <VBox spacing="5" alignment="CENTER">
                                <Label text="=" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox spacing="5">
                                <Label text="目标单位" style="-fx-font-weight: bold;"/>
                                <ComboBox fx:id="toUnitComboBox" prefWidth="200"/>
                                <Label text="结果:"/>
                                <Label fx:id="resultLabel" prefWidth="200" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="小数位数:"/>
                            <Spinner fx:id="decimalPlacesSpinner" prefWidth="80"/>
                            <CheckBox fx:id="scientificNotationCheckBox" text="科学计数法"/>
                            <Button text="添加到收藏" onAction="#handleAddToFavorites"/>
                        </HBox>

                        <Separator/>

                        <Label text="所有相关单位换算结果" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="allResultsTextArea" prefHeight="200" editable="false" wrapText="true"/>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="calculatorTab" text="计算器">
                <content>
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <TextField fx:id="calculatorDisplay" alignment="CENTER_RIGHT" prefHeight="50" style="-fx-font-size: 24;"/>

                        <GridPane hgap="5" vgap="5">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="20"/>
                                <ColumnConstraints percentWidth="20"/>
                                <ColumnConstraints percentWidth="20"/>
                                <ColumnConstraints percentWidth="20"/>
                                <ColumnConstraints percentWidth="20"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints prefHeight="50"/>
                                <RowConstraints prefHeight="50"/>
                                <RowConstraints prefHeight="50"/>
                                <RowConstraints prefHeight="50"/>
                                <RowConstraints prefHeight="50"/>
                                <RowConstraints prefHeight="50"/>
                            </rowConstraints>

                            <Button text="sin" onAction="#handleCalculatorFunction" GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity"/>
                            <Button text="cos" onAction="#handleCalculatorFunction" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
                            <Button text="tan" onAction="#handleCalculatorFunction" GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="Infinity"/>
                            <Button text="log" onAction="#handleCalculatorFunction" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>
                            <Button text="ln" onAction="#handleCalculatorFunction" GridPane.columnIndex="4" GridPane.rowIndex="0" maxWidth="Infinity"/>

                            <Button text="√" onAction="#handleCalculatorFunction" GridPane.columnIndex="0" GridPane.rowIndex="1" maxWidth="Infinity"/>
                            <Button text="(" onAction="#handleCalculatorFunction" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>
                            <Button text=")" onAction="#handleCalculatorFunction" GridPane.columnIndex="2" GridPane.rowIndex="1" maxWidth="Infinity"/>
                            <Button text="π" onAction="#handleCalculatorFunction" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>
                            <Button text="C" onAction="#handleCalculatorClear" GridPane.columnIndex="4" GridPane.rowIndex="1" maxWidth="Infinity" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>

                            <Button text="7" onAction="#handleCalculatorNumber" GridPane.columnIndex="0" GridPane.rowIndex="2" maxWidth="Infinity"/>
                            <Button text="8" onAction="#handleCalculatorNumber" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                            <Button text="9" onAction="#handleCalculatorNumber" GridPane.columnIndex="2" GridPane.rowIndex="2" maxWidth="Infinity"/>
                            <Button text="÷" onAction="#handleCalculatorOperator" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="Infinity"/>
                            <Button text="←" onAction="#handleCalculatorBackspace" GridPane.columnIndex="4" GridPane.rowIndex="2" maxWidth="Infinity"/>

                            <Button text="4" onAction="#handleCalculatorNumber" GridPane.columnIndex="0" GridPane.rowIndex="3" maxWidth="Infinity"/>
                            <Button text="5" onAction="#handleCalculatorNumber" GridPane.columnIndex="1" GridPane.rowIndex="3" maxWidth="Infinity"/>
                            <Button text="6" onAction="#handleCalculatorNumber" GridPane.columnIndex="2" GridPane.rowIndex="3" maxWidth="Infinity"/>
                            <Button text="×" onAction="#handleCalculatorOperator" GridPane.columnIndex="3" GridPane.rowIndex="3" maxWidth="Infinity"/>
                            <Button text="mod" onAction="#handleCalculatorOperator" GridPane.columnIndex="4" GridPane.rowIndex="3" maxWidth="Infinity"/>

                            <Button text="1" onAction="#handleCalculatorNumber" GridPane.columnIndex="0" GridPane.rowIndex="4" maxWidth="Infinity"/>
                            <Button text="2" onAction="#handleCalculatorNumber" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="Infinity"/>
                            <Button text="3" onAction="#handleCalculatorNumber" GridPane.columnIndex="2" GridPane.rowIndex="4" maxWidth="Infinity"/>
                            <Button text="-" onAction="#handleCalculatorOperator" GridPane.columnIndex="3" GridPane.rowIndex="4" maxWidth="Infinity"/>
                            <Button text="^" onAction="#handleCalculatorOperator" GridPane.columnIndex="4" GridPane.rowIndex="4" maxWidth="Infinity"/>

                            <Button text="0" onAction="#handleCalculatorNumber" GridPane.columnIndex="0" GridPane.rowIndex="5" maxWidth="Infinity"/>
                            <Button text="." onAction="#handleCalculatorNumber" GridPane.columnIndex="1" GridPane.rowIndex="5" maxWidth="Infinity"/>
                            <Button text="e" onAction="#handleCalculatorFunction" GridPane.columnIndex="2" GridPane.rowIndex="5" maxWidth="Infinity"/>
                            <Button text="+" onAction="#handleCalculatorOperator" GridPane.columnIndex="3" GridPane.rowIndex="5" maxWidth="Infinity"/>
                            <Button text="=" onAction="#handleCalculatorEquals" GridPane.columnIndex="4" GridPane.rowIndex="5" maxWidth="Infinity" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </GridPane>

                        <Label text="计算历史" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="calculatorHistoryTextArea" prefHeight="100" editable="false"/>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="batchTab" text="批量换算">
                <content>
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="单位类型:" prefWidth="80"/>
                            <ComboBox fx:id="batchUnitTypeComboBox" prefWidth="150"/>
                            <Label text="源单位:"/>
                            <ComboBox fx:id="batchFromUnitComboBox" prefWidth="150"/>
                        </HBox>

                        <HBox spacing="10">
                            <VBox spacing="5" VBox.vgrow="ALWAYS">
                                <Label text="输入数值 (每行一个)" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="batchInputTextArea" prefWidth="300" prefHeight="300" VBox.vgrow="ALWAYS" promptText="例如:&#10;10&#10;20.5&#10;100"/>
                                <HBox spacing="10">
                                    <Button text="开始换算" onAction="#handleBatchConvert" prefWidth="100" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                                    <Button text="导出结果" onAction="#handleBatchExport" prefWidth="100"/>
                                </HBox>
                            </VBox>

                            <VBox spacing="5" VBox.vgrow="ALWAYS">
                                <Label text="选择目标单位 (可选，不选则换算所有)" style="-fx-font-weight: bold;"/>
                                <ListView fx:id="batchToUnitsListView" prefWidth="200" prefHeight="300" VBox.vgrow="ALWAYS"/>
                            </VBox>

                            <VBox spacing="5" VBox.vgrow="ALWAYS">
                                <Label text="换算结果" style="-fx-font-weight: bold;"/>
                                <TextArea fx:id="batchResultsTextArea" prefWidth="300" prefHeight="300" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="customTab" text="自定义单位">
                <content>
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <Label text="添加新的自定义单位" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="100"/>
                                <ColumnConstraints prefWidth="200"/>
                                <ColumnConstraints prefWidth="100"/>
                                <ColumnConstraints prefWidth="200"/>
                            </columnConstraints>

                            <Label text="单位名称:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="customNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="例如: 光年"/>

                            <Label text="单位符号:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <TextField fx:id="customSymbolTextField" GridPane.columnIndex="3" GridPane.rowIndex="0" promptText="例如: ly"/>

                            <Label text="单位类型:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="customUnitTypeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="单位系统:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="customUnitSystemComboBox" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        </GridPane>

                        <HBox spacing="20">
                            <VBox spacing="5">
                                <RadioButton fx:id="factorRadioButton" text="使用换算因子" selected="true"/>
                                <GridPane hgap="10" vgap="5">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="100"/>
                                        <ColumnConstraints prefWidth="200"/>
                                    </columnConstraints>
                                    <Label text="换算因子:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="conversionFactorTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="相对于基准单位的倍数"/>
                                    <Label text="基准单位:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <ComboBox fx:id="baseUnitComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                </GridPane>
                            </VBox>

                            <VBox spacing="5">
                                <RadioButton fx:id="formulaRadioButton" text="使用换算公式"/>
                                <GridPane hgap="10" vgap="5">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="150"/>
                                        <ColumnConstraints prefWidth="300"/>
                                    </columnConstraints>
                                    <Label text="转换到基准单位 (用 x 表示输入值):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <TextField fx:id="toBaseFormulaTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="例如: (x - 32) * 5 / 9" disable="true"/>
                                    <Label text="从基准单位转换:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <TextField fx:id="fromBaseFormulaTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="例如: x * 9 / 5 + 32" disable="true"/>
                                </GridPane>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <Button text="添加单位" onAction="#handleAddCustomUnit" prefWidth="100" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                            <Button text="测试公式" onAction="#handleTestFormula" prefWidth="100"/>
                        </HBox>

                        <Separator/>

                        <Label text="已定义的自定义单位" style="-fx-font-weight: bold;"/>
                        <HBox spacing="10">
                            <ListView fx:id="customUnitsListView" prefWidth="400" prefHeight="150"/>
                            <VBox spacing="5">
                                <Button text="删除选中" onAction="#handleDeleteCustomUnit" prefWidth="100" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="historyTab" text="换算历史">
                <content>
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="最近换算记录" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                            <Button text="清空历史" onAction="#handleClearHistory" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                        </HBox>

                        <HBox spacing="10" VBox.vgrow="ALWAYS">
                            <ListView fx:id="conversionHistoryListView" prefWidth="300" VBox.vgrow="ALWAYS"/>
                            <TextArea fx:id="historyDetailTextArea" prefWidth="400" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="favoritesTab" text="收藏夹">
                <content>
                    <VBox spacing="10" style="-fx-padding: 20;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="收藏的单位" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                        </HBox>

                        <HBox spacing="10" VBox.vgrow="ALWAYS">
                            <ListView fx:id="favoritesListView" prefWidth="400" VBox.vgrow="ALWAYS"/>
                            <VBox spacing="5">
                                <Button text="移除收藏" onAction="#handleRemoveFromFavorites" prefWidth="100" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
