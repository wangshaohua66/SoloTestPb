<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.passwordmanager.controller.PasswordHistoryController">
    <children>
        <VBox layoutX="0.0" layoutY="0.0" prefHeight="450.0" prefWidth="600.0" spacing="10.0" style="-fx-padding: 15;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="密码历史记录">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Label fx:id="entryTitleLabel" style="-fx-font-style: italic;" text="(未选择)" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="密码标题: " />
                        <Label fx:id="titleLabel" style="-fx-font-weight: bold;" text="--" />
                    </children>
                </HBox>
                <HBox spacing="10.0">
                    <children>
                        <Label text="用户名: " />
                        <Label fx:id="usernameLabel" text="--" />
                    </children>
                </HBox>
                <TableView fx:id="historyTableView" prefHeight="280.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="changedAtColumn" prefWidth="150.0" text="修改时间">
                            <cellValueFactory>
                                <PropertyValueFactory property="changedAt" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="actionTypeColumn" prefWidth="70.0" text="操作类型">
                            <cellValueFactory>
                                <PropertyValueFactory property="actionType" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="oldPasswordColumn" prefWidth="300.0" text="旧密码">
                            <cellValueFactory>
                                <PropertyValueFactory property="oldPassword" />
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="copySelectedButton" mnemonicParsing="false" onAction="#handleCopySelected" prefHeight="35.0" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="复制选中密码" />
                        <Button fx:id="closeButton" cancelButton="true" mnemonicParsing="false" onAction="#handleClose" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="关闭" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
