# SMTP服务器配置
# QQ邮箱: smtp.qq.com (端口465 SSL)
# 163邮箱: smtp.163.com (端口465 SSL)
# Gmail: smtp.gmail.com (端口587 TLS)
# Outlook/Hotmail: smtp.office365.com (端口587 TLS)

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_password_or_auth_code
SENDER_NAME=批量邮件系统

# 重试配置
MAX_RETRIES=3
RETRY_DELAY=2.0
BACKOFF_MULTIPLIER=2.0

# SMTP超时时间(秒)
SMTP_TIMEOUT=30

# 是否使用TLS/SSL
SMTP_USE_TLS=True
SMTP_USE_SSL=False
