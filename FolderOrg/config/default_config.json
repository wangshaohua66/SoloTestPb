{
    "source_dir": "",
    "categories": {
        "documents": {
            "extensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".md", ".rtf", ".odt", ".ods", ".odp"],
            "target_dir": "Documents"
        },
        "images": {
            "extensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".tif", ".webp", ".svg", ".raw"],
            "target_dir": "Images"
        },
        "videos": {
            "extensions": [".mp4", ".avi", ".mkv", ".mov", ".wmv", ".flv", ".webm", ".m4v", ".mpg", ".mpeg"],
            "target_dir": "Videos"
        },
        "audio": {
            "extensions": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".wma", ".m4a", ".opus", ".alac"],
            "target_dir": "Audio"
        },
        "archives": {
            "extensions": [".zip", ".rar", ".7z", ".tar", ".gz", ".bz2", ".xz", ".tar.gz", ".tar.bz2"],
            "target_dir": "Archives"
        },
        "programs": {
            "extensions": [".exe", ".msi", ".dmg", ".pkg", ".deb", ".rpm", ".apk", ".app", ".bat", ".sh"],
            "target_dir": "Programs"
        },
        "others": {
            "extensions": [],
            "target_dir": "Others"
        }
    },
    "schedule": {
        "enabled": false,
        "interval": {
            "type": "daily",
            "value": "00:00"
        }
    },
    "logging": {
        "log_dir": "logs",
        "log_level": "INFO",
        "max_log_size": 10485760,
        "backup_count": 5
    }
}
